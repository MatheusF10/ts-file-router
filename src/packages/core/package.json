{
  "name": "ts-file-router",
  "version": "7.1.0",
  "description": "router based on project files using typescript",
  "type": "module",
  "bin": {
    "ts-file-router": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatheusF10/ts-file-router.git",
    "directory": "src/packages/core"
  },
  "author": "MatheusF10",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./react/vite": {
      "types": "./dist/react/vite.d.ts",
      "import": "./dist/react/vite.js",
      "require": "./dist/react/vite.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "chokidar": "5.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "chokidar": ">=4.0.0",
    "react": ">=18.0.0",
    "react-router-dom": ">=6.4.0",
    "vite": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "chokidar": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}

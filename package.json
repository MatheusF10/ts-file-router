{
  "name": "ts-file-router-monorepo",
  "private": true,
  "type": "module",
  "author": "MatheusF10",
  "license": "ISC",
  "workspaces": [
    "src/packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=ts-file-router",
    "build:core": "npm run build --workspace=ts-file-router",
    "dev": "npm run dev --workspace=ts-file-router",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:react": "vitest run src/packages/react",
    "test:core": "vitest run src/packages/core",
    "prepare": "husky",
    "check:version": "bash .github/pipelines/check-version-bump.sh origin/master",
    "release": "npm run build && bash .github/pipelines/publish-changed.sh"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "oxlint"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "oxlint": "1.87.0",
    "react-dom": "^19.3.0",
    "rimraf": "6.1.2",
    "vitest": "^5.0.3"
  }
}
